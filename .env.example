# --- Required secrets ---
OPENAI_API_KEY=sk-your-openai-key

# Choose one issue provider (set only what you use)
# Jira
JIRA_EMAIL=dev@example.com
JIRA_API_TOKEN=your-api-token
# GitHub
GITHUB_TOKEN=ghp_your-token

# --- Core workflow inputs ---
SDLC_CODING_AGENT_PROVIDER=claude
SDLC_AGENT_MODEL=gpt-4.1-mini
SDLC_JSON_OUTPUT=true

# --- Temporal connection ---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
SDLC_TASK_QUEUE=agentsflow-sdlc

# --- Logging ---
AGENTSFLOW_LOG_LEVEL=INFO

# --- ACP binaries & permissions ---
ACP_AUTO_APPROVE=true
ACP_CLAUDE_BIN=/usr/local/bin/claude-code-acp
ACP_GEMINI_BIN=
ACP_CODEX_BIN=
# ACP_STREAM_READER_LIMIT bytes (default 8388608)
ACP_STREAM_READER_LIMIT=8388608

# --- Provider tuning (optional) ---
JIRA_HOST_ALLOWLIST=
JIRA_TIMEOUT_SECONDS=15
GITHUB_TIMEOUT_SECONDS=15
