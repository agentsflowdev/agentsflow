# Temporal connection
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
SDLC_TASK_QUEUE=agentsflow-sdlc

# Claude ACP configuration (optional)
CLAUDE_CODE_BIN=/usr/local/bin/claude-code-acp
CLAUDE_AUTO_APPROVE=true

# OpenAI API key for SDLC agents
OPENAI_API_KEY=sk-your-openai-key

# Jira authentication
JIRA_EMAIL=dev@example.com
JIRA_API_TOKEN=your-api-token
SDLC_JIRA_URL=https://example.atlassian.net/browse/ABC-123

# Repository checkout
SDLC_REPOSITORY=/Users/you/repos/project
SDLC_REFERENCE=main

# Workflow configuration
SDLC_WORKFLOW_ID=sdlc-abc-123
SDLC_AGENT_MODEL=gpt-4.1-mini
SDLC_JSON_OUTPUT=true
